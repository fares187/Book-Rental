{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Error",
    "Override": { "Microsoft": "Error" },
    "Properties": {
      "ApplicationName": "PeacockBook.web"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/PeacockBook_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{TimeStamp} {Massage}{NewLine:1}{Exception:1}"
        }

      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/PeacockBook_.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter,serilog"
        }

      },
      {


        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "",
          "tableName": "ErrorLogs",
          "schemaName": "logging",
          "needAutoCreateTable": true,
          "needAutoCreateSchema": true,
          "loggerColumnOptions": {
            "Id": {
              "Name": "IdAutoIncrement",
              "Order": 0
            },
            "TimeStamp": {
              "Name": "Timestamp",
              "Order": 2
            },
            "LogEvent": {
              "Name": "LogEvent",
              "Order": 3
            }
          },
          "loggerPropertyColumnOptions": {
            "TestColumnName": {
              "Format": "{0}",
              "Name": "TestProperty",
              "WriteMethod": "Raw",
              "DbType": "Text",
              "Order": 1
            }
          }
        }

      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "AllowedHosts": "*",
  "CloudinarySettings": {
    "CloudName": "",
    "APIKey": "",
    "APISecret": "",
    "APIEnvironmentvariable": ""
  },
  "MailSettings": {
    "Email": "",
    "DisplayName": "PeacockBook",
    "Password": "",
    "Host": "smtp-mail.outlook.com",
    "Port": "587",
    "DevtempEmail": ""
  }
}
